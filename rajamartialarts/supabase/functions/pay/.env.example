# Secrets for the "pay" Edge Function. These live ONLY in Supabase (Project → Edge Functions → Secrets,
# or `supabase secrets set NAME=value`). Never put real values in this file, in config.js, or in git.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# --- general ---
PAYMENTS_MODE=sandbox                     # sandbox | live   (keep sandbox until every test below has passed)
SITE_URL=https://your-site.example        # where customers are sent after paying (no trailing slash)
ALLOWED_ORIGINS=https://your-site.example # comma-separated; leave unset to allow any origin

# --- JazzCash (from your JazzCash merchant portal / sandbox) ---
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# Optional overrides: take the exact values from JazzCash's official documentation
JAZZCASH_CHECKOUT_URL=
JAZZCASH_INQUIRY_URL=
JAZZCASH_VERSION=1.1
JAZZCASH_TXN_TYPE=
JAZZCASH_BANK_ID=
JAZZCASH_PRODUCT_ID=
JAZZCASH_OK_CODE=000
JAZZCASH_DONE_STATUS=Completed

# --- Easypaisa: not implemented yet (needs the official Easypay documentation + sandbox credentials) ---
