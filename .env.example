# Copy to ".env" and fill in. Never commit your real .env.

# Port the server listens on (hosts usually set this automatically)
PORT=3000

# Protects /admin and /api/leads. Use a long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string

# OPTIONAL: forward every lead to a webhook (Zapier/Make/Google Apps Script/CRM).
# Leave blank to only store leads in data/leads.ndjson.
LEAD_WEBHOOK_URL=
