# ─────────────────────────────────────────────────────────────
# Islamabad Thrift Store — environment variables
# Copy this file to ".env.local" for local development, and add the same
# values in Netlify under: Site settings → Environment variables.
# NONE of these are secret admin passwords — the anon key is safe to expose;
# your data is protected by database Row-Level Security (see supabase/schema.sql).
# ─────────────────────────────────────────────────────────────

# From Supabase dashboard → Project Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# From Supabase dashboard → Project Settings → API → "anon / public" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The public address of your deployed site (used for SEO / social share tags).
# On Netlify this is e.g. https://your-site-name.netlify.app or your custom domain.
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
